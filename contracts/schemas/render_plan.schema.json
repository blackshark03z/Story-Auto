{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story-auto-render-plan/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "render_mode",
    "master_duration",
    "segments"
  ],
  "properties": {
    "schema_version": {
      "const": "story-auto-render-plan/1.0.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 3
    },
    "render_mode": {
      "enum": [
        "hybrid_hook",
        "full_video_ai"
      ]
    },
    "master_duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  }
}
