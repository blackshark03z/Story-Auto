{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story-auto-generation-requests/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "requests"
  ],
  "properties": {
    "schema_version": {
      "const": "story-auto-generation-requests/1.0.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 3
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "prompt_version": {
      "type": "string"
    },
    "guardrail_estimate": {
      "type": "object"
    },
    "provider_execution_authorized": {
      "type": "boolean"
    },
    "review_status": {
      "type": "string"
    }
  }
}
