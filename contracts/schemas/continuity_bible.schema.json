{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story-auto-continuity-bible/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "style",
    "characters",
    "locations",
    "props"
    ,"provenance"
    ,"review_status"
  ],
  "properties": {
    "schema_version": {
      "const": "story-auto-continuity-bible/1.0.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 3
    },
    "style": {
      "type": "object"
    },
    "characters": {
      "type": "array"
    },
    "locations": {
      "type": "array"
    },
    "props": {
      "type": "array"
    },
    "provenance": {"type": "object"},
    "review_status": {"enum": ["DRAFT", "VALIDATED", "APPROVED"]}
  }
}
