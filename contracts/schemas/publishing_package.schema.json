{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story-auto-publishing-package/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "title_candidates",
    "selected_title",
    "description",
    "thumbnail",
    "approved"
  ],
  "properties": {
    "schema_version": {
      "const": "story-auto-publishing-package/1.0.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 3
    },
    "title_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "selected_title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "thumbnail": {
      "type": "object"
    },
    "approved": {
      "type": "boolean"
    },
    "provenance": {
      "type": "object"
    }
  }
}
