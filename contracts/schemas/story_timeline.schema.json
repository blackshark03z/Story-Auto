{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "story-auto-story-timeline/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "alignment_sha256",
    "scenes",
    "provenance",
    "review_status"
  ],
  "properties": {
    "schema_version": {
      "const": "story-auto-story-timeline/1.0.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 3
    },
    "alignment_sha256": {
      "type": "string"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "provenance": {"type": "object"},
    "review_status": {"enum": ["DRAFT", "VALIDATED", "APPROVED"]}
  }
}
